<?xml version="1.0" encoding="utf-8"?>
<ESRI.Configuration xmlns="http://schemas.esri.com/Desktop/AddIns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>ArcMap Agent</Name>
  <AddInID>{6F3A9C52-8B14-4E2D-9A7B-1D5C0E4F83A6}</AddInID>
  <Description>自然语言操控 ArcMap 的 AI 助手（C# .NET Add-In）</Description>
  <Version>0.4.3</Version>
  <Image>Images\agent32.png</Image>
  <Author>bunkr</Author>
  <Company>ArcMapAgent</Company>
  <Date>9/29/2026</Date>
  <Targets>
    <Target name="Desktop" version="10.0" />
  </Targets>
  <AddIn language="CLR" library="ArcMapAgent.dll" namespace="ArcMapAgent">
    <ArcMap>
      <Commands>
        <Button id="ArcMapAgent_ShowDockableWindow"
                class="ShowDockableWindowButton"
                message="打开 ArcMap Agent 聊天面板"
                caption="ArcMap Agent"
                tip="打开 ArcMap Agent 聊天面板"
                category="ArcMap Agent"
                image="Images\show16.png"
                onDemand="false" />
      </Commands>
      <Extensions>
        <!-- autoLoad="true" 必须显式写出：schema 默认值是 false（just-in-time），
             只写 id/class 时 OnStartup() 永远不会在启动时被调用，
             曾导致「工具栏按钮有、面板不出现、AppContext.Application 未注入」。 -->
        <Extension id="ArcMapAgent_AgentExtension"
                   class="AgentExtension"
                   autoLoad="true" />
      </Extensions>
      <DockableWindows>
        <DockableWindow id="ArcMapAgent_AgentDockableWindow"
                        class="AgentDockableWindow"
                        caption="ArcMap Agent"
                        category="ArcMap Agent"
                        image="Images\agent32.png" />
      </DockableWindows>
      <Toolbars>
        <Toolbar id="ArcMapAgent_Toolbar"
                 caption="ArcMap Agent"
                 category="ArcMap Agent"
                 showInitially="true">
          <Items>
            <Button refID="ArcMapAgent_ShowDockableWindow" />
          </Items>
        </Toolbar>
      </Toolbars>
    </ArcMap>
  </AddIn>
</ESRI.Configuration>
